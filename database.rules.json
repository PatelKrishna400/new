{
  "rules": {
    "players": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null",
        "diamonds": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "coins": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "diamondWins": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "piggyBank": {
          "totalStored": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": ["diamondWins", "coins", "level", "lastActive"],
      "$uid": {
        ".write": "auth != null",
        "diamondWins": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "mega_rewards": {
      ".read": true,
      ".write": "auth != null"
    },
    "reward_requests": {
      ".read": true,
      ".write": "auth != null",
      "$reqId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "suggestions": {
      ".read": true,
      "$sugId": {
        ".write": "auth != null"
      }
    },
    "ads_direct_clicks": {
      ".read": true,
      "$clickId": {
        ".write": "auth != null"
      }
    },
    "website_tasks_config": {
      ".read": true,
      ".write": "auth != null"
    },
    "telegram_tasks_config": {
      ".read": true,
      ".write": "auth != null"
    },
    "monthly_tasks_config": {
      ".read": true,
      ".write": "auth != null"
    },
    "monthly_competition": {
      ".read": true,
      ".write": "auth != null"
    },
    "season": {
      ".read": true,
      ".write": "auth != null"
    },
    "ads_analytics": {
      ".read": true,
      "directClicks": {
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "monetagViews": {
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    },
    "ads_config": {
      ".read": true,
      ".write": "auth != null"
    },
    "whitelist": {
      ".read": true,
      "$uid": {
        ".write": "auth != null"
      }
    },
    "admin_users": {
      ".read": true,
      ".write": "auth != null"
    },
    "game_config": {
      ".read": true,
      ".write": "auth != null"
    },
    "levels_config": {
      ".read": true,
      ".write": "auth != null"
    },
    "fuel_cells_config": {
      ".read": true,
      ".write": "auth != null"
    },
    "identityIndex": {
      ".read": true,
      ".write": "auth != null"
    },
    "auth_config": {
      ".read": true,
      ".write": "auth != null"
    },
    "activity_log": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    }
  }
}
