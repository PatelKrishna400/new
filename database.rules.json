{
  "rules": {
    "players": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "$uid === auth.uid || auth == null || true",
        "coins": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "energy": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "lastSaved": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
