{
  "rules": {
    "players": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "!root.child('deleted_users').child($uid).exists()"
      }
    },
    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "!root.child('deleted_users').child($uid).exists()"
      }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": ["coins", "level", "energyTaps", "lastActive"],
      "$uid": {
        ".write": "!root.child('deleted_users').child($uid).exists()"
      }
    },
    "mega_rewards": {
      ".read": true,
      ".write": true
    },
    "reward_requests": {
      ".read": true,
      ".write": true,
      "$reqId": {
        ".read": true,
        ".write": true
      }
    },
    "suggestions": {
      ".read": true,
      ".write": true,
      "$sugId": {
        ".read": true,
        ".write": true
      }
    },
    "ads_direct_clicks": {
      ".read": true,
      ".write": true,
      "$clickId": {
        ".read": true,
        ".write": true
      }
    },
    "website_tasks_config": {
      ".read": true,
      ".write": true
    },
    "telegram_tasks_config": {
      ".read": true,
      ".write": true
    },
    "monthly_tasks_config": {
      ".read": true,
      ".write": true
    },
    "monthly_competition": {
      ".read": true,
      ".write": true
    },
    "season": {
      ".read": true,
      ".write": true
    },
    "ads_config": {
      ".read": true,
      ".write": true
    },
    "whitelist": {
      ".read": true,
      "$uid": {
        ".write": true
      }
    },
    "admin_users": {
      ".read": true,
      ".write": true
    },
    "game_config": {
      ".read": true,
      ".write": true
    },
    "levels_config": {
      ".read": true,
      ".write": true
    },
    "fuel_cells_config": {
      ".read": true,
      ".write": true
    },
    "identityIndex": {
      ".read": true,
      ".write": true
    },
    "auth_config": {
      ".read": true,
      ".write": true
    },
    "activity_log": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp"]
    },
    "deleted_users": {
      ".read": true,
      ".write": true
    },
    "account_requests": {
      ".read": true,
      ".write": true,
      "$reqId": {
        ".read": true,
        ".write": true
      }
    }
  }
}
