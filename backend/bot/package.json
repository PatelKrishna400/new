{
  "name": "tap-empire-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Tap Empire — Telegram bot process (webhook registration + admin utilities)",
  "main": "bot.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "start":            "node bot.js",
    "register-webhook": "node bot.js --register-webhook",
    "delete-webhook":   "node bot.js --delete-webhook",
    "set-commands":     "node bot.js --set-commands",
    "get-info":         "node bot.js --get-info"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "node-telegram-bot-api": "0.66.0"
  }
}
