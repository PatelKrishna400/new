rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users: authenticated users can read, create, and update their profile ──
    match /users/{userId} {
      allow read:           if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete:         if false;
    }

    // ── Leaderboard: public read, authenticated create & update ──
    match /leaderboard/{userId} {
      allow read:           if true;
      allow create, update: if request.auth != null;
      allow delete:         if false;
    }

    // ── Transactions: authenticated read, create, and update ──
    match /transactions/{txId} {
      allow read:           if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete:         if false;
    }

    // ── Withdrawals: owning user read-only, backend Cloud Functions write ──
    match /withdrawals/{wdId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Game config: public read (economy parameters), admin write ──
    match /gameConfig/{docId} {
      allow read:  if true;
      allow write: if false; // admin writes via Cloud Function
    }

    // ── Ad sessions: authenticated create & update ──
    match /adSessions/{sessionId} {
      allow read:           if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete:         if false;
    }

    // ── Stars purchases: owning user read-only ──
    match /starsPurchases/{purchaseId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Referrals: authenticated create & update ──
    match /referrals/{refId} {
      allow read:           if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete:         if false;
    }

    // ── Admin logs: deny all client access ──
    match /adminLogs/{logId} {
      allow read, write: if false;
    }

    // ── Deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
